APP_NAME="Marcos Túlio Advocacia — Demonstração"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://marcos-tulio-advocacia.test
APP_TIMEZONE=America/Cuiaba

APP_LOCALE=pt_BR
APP_FALLBACK_LOCALE=pt_BR
APP_FAKER_LOCALE=pt_BR

APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Base MySQL locale indépendante. Aucun préfixe n'est nécessaire en local.
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=marcos_tulio_advocacia
DB_USERNAME=root
DB_PASSWORD=
DB_PREFIX=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_COOKIE=maracuja_avocat_session
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=false

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
CACHE_STORE=database
CACHE_PREFIX=maracuja_avocat_

MAIL_MAILER=log
MAIL_FROM_ADDRESS="demo-avocat@example.test"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"

MARACUJA_PRODUCT_NAME="Marcos Túlio Advocacia"
MARACUJA_THEME=law-firm
MARACUJA_OFFER=signature
MARACUJA_INDEXABLE=false
MARACUJA_DEMO_MODE=true
MARACUJA_WHATSAPP_URL=https://example.test/whatsapp-demo
MARACUJA_MODULE_ORAL_DEFENSES=true
MARACUJA_MODULE_ASSISTANT=false
MARACUJA_ASSISTANT_PROVIDER=fake
MARACUJA_INQUIRY_RETENTION_DAYS=90
MARACUJA_MODULE_APPOINTMENTS=true
MARACUJA_MODULE_CONTACTS=true
MARACUJA_MODULE_CONVERSATIONS=true
MARACUJA_CONVERSATIONS_AI_PROVIDER=fake
MARACUJA_CONVERSATIONS_HISTORY_MESSAGES=24
MARACUJA_CONVERSATIONS_AI_TIMEOUT=20
MARACUJA_CONVERSATIONS_RETENTION_DAYS=90
MARACUJA_CONVERSATIONS_ARCHIVE_INACTIVE_AFTER_HOURS=48
MARACUJA_CONVERSATIONS_REFERENCE_LENGTH=6
MARACUJA_CONVERSATIONS_NOTIFICATIONS_ENABLED=true
MARACUJA_CONVERSATIONS_NOTIFICATION_EMAIL=
# Produção: alterar o provider para openai e guardar a chave somente no ambiente.
OPENAI_API_KEY=
OPENAI_CONVERSATIONS_MODEL=gpt-5.6-luna
OPENAI_CONVERSATIONS_REASONING_EFFORT=low
OPENAI_CONVERSATIONS_MAX_OUTPUT_TOKENS=600

MARACUJA_MODULE_SITE_SETTINGS=true
MARACUJA_MODULE_NOTICES=true
MARACUJA_MODULE_CONTENT_SLOTS=true
MARACUJA_MODULE_PAGES=true
MARACUJA_MODULE_NEWS=false
MARACUJA_MODULE_ARTICLES=false
MARACUJA_MODULE_VENUES=false
MARACUJA_MODULE_EVENTS=false
MARACUJA_MODULE_GALLERY=true
MARACUJA_MODULE_CONTACT_FORM=true
MARACUJA_MODULE_INQUIRIES=true
MARACUJA_MODULE_AUDIENCE=false
MARACUJA_MODULE_CAMPAIGNS=false
MARACUJA_DEV_PAGES_ADMIN=false
MARACUJA_DEV_IMAGE_OPTIMIZATION=false
